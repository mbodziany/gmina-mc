# --- Minecraft server to monitor ---
# Address from joinmc.gg (without port if it uses an SRV record, otherwise host only)
MC_HOST=twoj-serwer.joinmc.gg
# Port is optional. Leave empty to use the default (25565) / SRV record resolution.
MC_PORT=

# How often to poll the server, in seconds (SLP fallback)
POLL_INTERVAL_SECONDS=20
# After how many consecutive failed polls we consider everyone offline
OFFLINE_GRACE_POLLS=3
# SLP's player sample is capped (~12). When more players are online than the
# sample shows, a missing player is only marked offline after this many
# seconds without appearing in any sample.
SLP_STALE_SECONDS=180

# Anti-flap: a player who rejoins within this many seconds of leaving does
# not trigger another push notification.
PUSH_REJOIN_COOLDOWN_SECONDS=300

# --- In-game plugin (primary source) ---
# Shared secret the Paper plugin sends as: Authorization: Bearer <INGEST_TOKEN>
# Leave empty to disable the plugin endpoints and rely on SLP only.
INGEST_TOKEN=
# How long (seconds) after the last plugin heartbeat we keep trusting the plugin
# before falling back to SLP pinging.
PLUGIN_TIMEOUT_SECONDS=60
# Max requests per minute per IP on /api/ingest/* (flood protection)
INGEST_RATE_LIMIT_PER_MINUTE=240

# How far back the "recent players" roster reaches, in days
ROSTER_DAYS=7

# --- HTTP API ---
PORT=8080
# Optional shared secret. If set, clients must send header: Authorization: Bearer <API_TOKEN>
API_TOKEN=

# Where to store the SQLite database file
DB_PATH=./data/gmina.db

# --- Apple Push Notifications (APNs) ---
# All four are required to enable push. Leave empty to disable push (API still works).
# Contents of the .p8 key file (AuthKey_XXXX.p8). You can paste it with literal \n or real newlines.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# Your app's bundle identifier, e.g. xyz.mikebravo.gminamc
APNS_BUNDLE_ID=
# true for App Store / TestFlight builds, false for development builds
APNS_PRODUCTION=false
