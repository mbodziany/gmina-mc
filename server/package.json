{
  "name": "gmina-mc-server",
  "version": "1.0.0",
  "description": "Poller + API for tracking Minecraft players online status via Server List Ping, with APNs push.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "simulate": "node scripts/simulate.mjs",
    "test": "tsx --test test/tracker.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@parse/node-apn": "^6.0.1",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "minecraft-server-util": "^5.4.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
